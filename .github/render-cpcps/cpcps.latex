\documentclass[a4paper,12pt]{article}

\usepackage[
  a4paper,
  top=3cm,
  bottom=2.5cm,
  left=2.5cm,
  right=2cm,
  includehead,
  includefoot,
  headheight=40pt
]{geometry}

% Metric-compatible stand-ins for the fonts used by the reference document:
% TeX Gyre Termes = Times New Roman, Heros = Arial, Cursor = Courier New,
% Caladea = Cambria (used for the ToC and version-control titles).
\usepackage{fontspec}
\setmainfont{TeX Gyre Termes}
\setsansfont{TeX Gyre Heros}
\setmonofont{TeX Gyre Cursor}
\newfontfamily{\cambriafont}{Caladea}

\usepackage[table]{xcolor}
\definecolor{VcsBlue}{HTML}{000080}      % version-control table header
\definecolor{ShadedOrange}{HTML}{FFCC99} % shaded table rows
\definecolor{LinkBlue}{HTML}{0000FF}     % hyperlinks

% Tables. The cpcps.lua filter renders all tables as fully bordered
% longtables; longtable/booktabs/array/calc are also what pandoc's own writer
% needs if the filter ever falls back to native table output.
\usepackage{longtable,booktabs,array,calc}
\renewcommand{\arraystretch}{1.3}

% Commands pandoc's LaTeX writer expects from the template
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\providecommand{\pandocbounded}[1]{#1}

% Lists of arbitrary depth and marker style, as emitted by pandoc
\usepackage{enumitem}
\setlistdepth{9}
\renewlist{itemize}{itemize}{9}
\setlist[itemize]{label=\textbullet}
\renewlist{enumerate}{enumerate}{9}
\setlist[enumerate,1]{label=\arabic*.}
\setlist[enumerate,2]{label=\alph*.}
\setlist[enumerate,3]{label=\roman*.}
\setlist[enumerate,4]{label=\arabic*.}
\setlist[enumerate,5]{label=\alph*.}
\setlist[enumerate,6]{label=\roman*.}
\setlist[enumerate,7]{label=\arabic*.}
\setlist[enumerate,8]{label=\alph*.}
\setlist[enumerate,9]{label=\roman*.}

% Block paragraphs (no indent), justified text
\usepackage{parskip}
\setlength{\emergencystretch}{3em}

% Headings: Arial-like bold, black, size descending with level. Section
% numbers are inline in the heading text, so LaTeX numbering is disabled.
% Top-level sections start on a new page.
\usepackage{titlesec}
\setcounter{secnumdepth}{-\maxdimen}
\titleformat{\section}[hang]{\clearpage\sffamily\fontsize{17}{20}\selectfont\bfseries}{}{0pt}{}
\titleformat{\subsection}[hang]{\sffamily\fontsize{15}{18}\selectfont\bfseries}{}{0pt}{}
\titleformat{\subsubsection}[hang]{\sffamily\fontsize{13}{16}\selectfont\bfseries}{}{0pt}{}
\titleformat{\paragraph}[hang]{\sffamily\fontsize{12}{15}\selectfont\bfseries}{}{0pt}{}
\titleformat{\subparagraph}[hang]{\sffamily\fontsize{12}{15}\selectfont\bfseries\itshape}{}{0pt}{}
\titlespacing*{\section}{0em}{0em}{1.5em}
\titlespacing*{\subsection}{0em}{2em}{0.8em}
\titlespacing*{\subsubsection}{0em}{1.6em}{0.6em}
\titlespacing*{\paragraph}{0em}{1.4em}{0.5em}
\titlespacing*{\subparagraph}{0em}{1.2em}{0.5em}

% Table of contents: Caladea-bold title; level 1 bold with dot leaders,
% level 2 small caps, level 3 italic, level 4 regular; page numbers right.
\usepackage{tocloft}
\setcounter{tocdepth}{4}
\renewcommand{\cftdotsep}{0.5}
\setlength{\cftbeforesecskip}{1em}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsecfont}{\bfseries}
\renewcommand{\cftsecpagefont}{\bfseries}
\renewcommand{\cftsubsecfont}{\scshape}
\renewcommand{\cftsubsubsecfont}{\itshape}
\cftsetindents{section}{0em}{2.5em}
\cftsetindents{subsection}{2.5em}{3.4em}
\cftsetindents{subsubsection}{5.9em}{4.3em}
\cftsetindents{paragraph}{10.2em}{5.2em}
% Draw the ToC title directly instead of via \section*, so the titlesec
% section format (sans serif + page break) does not interfere.
\makeatletter
\renewcommand{\@cftmaketoctitle}{{\raggedright\cambriafont\bfseries\LARGE\contentsname\par}\vspace{1.5em}}
\makeatother

% Running header (three centered serif lines) and "Page N out of M" footer.
% Both apply from the version-control pages onward (see document flow below).
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[C]{\footnotesize%
$if(author)$$for(author)$$author$$sep$, $endfor$\\$endif$%
$if(subtitle)$$subtitle$\\$endif$%
$if(document-title)$$document-title$$if(version)$ (v$version$)$endif$$endif$}
\fancyfoot[C]{\small Page \thepage\ out of \pageref{LastPage}}

% Landscape pages (::: landscape fenced divs, see cpcps.lua)
\usepackage{pdflscape}

\usepackage[colorlinks,breaklinks]{hyperref}
\hypersetup{
  linkcolor=LinkBlue,
  urlcolor=LinkBlue,
  pdftitle={$title-meta$},
  pdfauthor={$author-meta$}
}
\urlstyle{same}

\begin{document}

% Title page: unnumbered, no header/footer
\begin{titlepage}
  \centering
  \vspace*{2.5cm}
  {\LARGE\bfseries $title$\par}
$if(subtitle)$
  \vspace{0.6cm}
  {\Large\bfseries $subtitle$\par}
$endif$
  \vspace{1.2cm}
$if(author)$
  {\large $for(author)$$author$$sep$, $endfor$\par}
$endif$
$if(document-title)$
  \vspace{0.4cm}
  {\large $document-title$\par}
$endif$
  \vfill
$if(version)$
  {\large Version $version$$if(date)$ ($date$)$endif$\par}
$endif$
\end{titlepage}

% Table of contents: unnumbered pages, no running header/footer, black links
\pagenumbering{roman}
\pagestyle{empty}
{
  \hypersetup{linkcolor=black}
  \tableofcontents
}

% Body (starting with the version-control pages): arabic numbering restarts
% at 1, running header and footer apply from here on
\clearpage
\pagenumbering{arabic}
\pagestyle{fancy}

$body$

\end{document}
